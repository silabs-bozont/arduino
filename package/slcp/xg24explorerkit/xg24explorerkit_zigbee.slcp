project_name: zigbee_arduino_gsdk_config_xg24explorerkit
package: Zigbee
label: Arduino Zigbee and GSDK config for the Silicon Labs xG24 Explorer Kit
description: >
  Arduino Zigbee and GSDK config for the Silicon Labs xG24 Explorer Kit (brd2703a)
quality: production

sdk_extension:
  - id: aiml
    version: 3.0.2

component:
  # System
  - id: sl_system
  - id: device_init
  - id: clock_manager

  # Zigbee stack (Router)
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_gp
  - id: zigbee_zcl_framework_core

  # ZCL clusters
  - id: zigbee_basic
  - id: zigbee_identify
  - id: zigbee_groups_server
  - id: zigbee_on_off
  - id: zigbee_level_control
  - id: zigbee_color_control_server
  - id: zigbee_scenes
  - id: zigbee_reporting
  - id: zigbee_counters
  - id: zigbee_ias_zone_server

  # ZLL
  - id: zigbee_zll
  - id: zigbee_zll_commissioning_common
  - id: zigbee_zll_commissioning_server
  - id: zigbee_zll_on_off_server
  - id: zigbee_zll_level_control_server
  - id: zigbee_zll_identify_server
  - id: zigbee_zll_scenes_server
  - id: zigbee_zll_utility_server
  - id: zigbee_interpan

  # Zigbee 3.0 networking
  - id: zigbee_network_creator
  - id: zigbee_network_creator_security
  - id: zigbee_network_steering
  - id: zigbee_find_and_bind_target
  - id: zigbee_scan_dispatch
  - id: zigbee_update_tc_link_key

  # Green Power
  - id: zigbee_green_power_common
  - id: zigbee_green_power_client

  # RTOS / IPC — token interface required with zigbee_ipc (weak stubs are excluded)
  - id: zigbee_ipc
  - id: zigbee_token_interface
  - id: freertos

  # Radio
  - id: rail_util_pti

  # Arduino platform components
  - id: psa_crypto
  - id: power_manager
  - id: bootloader_interface
  - id: app_assert
  - id: component_catalog
  - id: mpu
  - id: udelay
  - id: app_log
  - id: iostream_eusart
    instance:
     - vcom
  - id: iostream_eusart
    instance:
    - xg24explorerkit1
  - id: i2cspm
    instance:
     - mikroe
     - qwiic
  - id: spidrv_eusart
    instance:
     - xg24explorerkit1
  - id: spidrv_usart
    instance:
     - mikroe
  - id: emlib_iadc
  - id: pwm
    instance:
    - led0
  - id: emlib_vdac
  - id: gpiointerrupt
  - id: emlib_rmu
  - id: emlib_wdog
  - id: nvm3_default
  - id: nvm3_default_config
  - id: nvm3_default_flash_backend
  - id: nvm3_lib
  - id: memory_manager_cpp
  # AI/ML components
  - id: tensorflow_lite_micro
    from: aiml
  - id: tensorflow_debug_log_none
    from: aiml
  - id: tensorflow_lite_micro_accelerated_kernels
    from: aiml

requires:
  - name: brd2703a

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

config_file:
  - path: config/zcl/zcl_config.zap
    file_id: zap_configuration_file_id
    directory: zcl
  - path: sl_spidrv_eusart_xg24explorerkit1_config.h
    override:
      component: spidrv_eusart
      instance: xg24explorerkit1
      file_id: spidrv_eusart_config
  - path: sl_iostream_eusart_xg24explorerkit1_config.h
    override:
      component: iostream_eusart
      instance: xg24explorerkit1
      file_id: iostream_eusart_config

define:
  - name: TF_LITE_STATIC_MEMORY
    value: "1"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "32768"
  # Required by zigbee_token_interface
  - name: USE_NVM3
    value: "1"

configuration:
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE
    value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_ROUTER
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE
    value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_AF_PLUGIN_NETWORK_STEERING_SCAN_DURATION
    value: 3
  - name: SL_ZIGBEE_AF_PLUGIN_NETWORK_STEERING_TRY_ALL_KEYS
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_IAS_ZONE_SERVER_ZONE_TYPE
    value: SL_ZIGBEE_ZCL_IAS_ZONE_TYPE_CONTACT_SWITCH
  - name: SL_ZIGBEE_AF_PLUGIN_IAS_ZONE_SERVER_ENABLE_QUEUE
    value: 1
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_SPIDRV_EUSART_MIKROE_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: SL_SPIDRV_EUSART_XG24EXPLORERKIT1_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 600
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: SL_STACK_SIZE
    value: 1024
  - name: SL_TFLITE_MICRO_ARENA_SIZE
    value: "8192"
  - name: configTIMER_TASK_PRIORITY
    value: 53

tag:
  - hardware:rf:band:2400
