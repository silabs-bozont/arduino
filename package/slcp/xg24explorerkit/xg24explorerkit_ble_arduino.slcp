project_name: bt_arduino_gsdk_config_xg24explorerkit
package: Bluetooth
label: Bluetooth - Arduino GSDK config for the xG24 Explorer Kit (brd2703a) (Based on SoC Empty)
description: >
  This slcp can be used in place of SoC Empty to generate the
  SDK files needed for the Arduino Core (BLE Arduino / HCI controller).
category: Bluetooth Examples
quality: production

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

sdk_extension:
  - id: aiml
    version: 3.0.2
  - id: arduino_ble_hci
    version: 1.0.0

component:
  - id: sl_system
  - id: clock_manager
  - id: device_init
  - id: psa_crypto
  - id: power_manager
  - id: bootloader_interface
  - id: app_assert
  - id: component_catalog
  - id: mpu
  - id: udelay
  - id: app_log
  - id: iostream_eusart
    instance:
     - vcom
  - id: iostream_eusart
    instance:
    - xg24explorerkit1
  - id: i2cspm
    instance:
     - mikroe
     - qwiic
  - id: spidrv_eusart
    instance:
     - xg24explorerkit1
  - id: spidrv_usart
    instance:
     - mikroe
  - id: emlib_iadc
  - id: freertos
  - id: pwm
    instance:
    - led0
  - id: emlib_vdac
  - id: gpiointerrupt
  - id: emlib_rmu
  - id: emlib_wdog
  - id: nvm3_default
  - id: nvm3_default_config
  - id: nvm3_default_flash_backend
  - id: nvm3_lib
  - id: bluetooth_controller
  - id: bluetooth_feature_connection
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_connection_phy_update
  - id: bluetooth_feature_extended_advertiser
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_periodic_advertiser
  # Local extension (slcp/common/arduino_ble_hci): HCI reset + ArduinoBLE
  # name compat (sl_bt_controller_*), without selecting bluetooth_hci RCP (that
  # pulls UART/CPC transport and fights Arduino Serial/VCOM). Compat also calls
  # sl_btctrl_configure_le_buffer_size() so ACL/GATT works without RCP catalog.
  - id: bluetooth_hci_reset
    from: arduino_ble_hci
  - id: memory_manager_cpp
  # AI/ML components
  - id: tensorflow_lite_micro
    from: aiml
  - id: tensorflow_debug_log_none
    from: aiml
  - id: tensorflow_lite_micro_accelerated_kernels
    from: aiml

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

config_file:
  - path: sl_spidrv_eusart_xg24explorerkit1_config.h
    override:
      component: spidrv_eusart
      instance: xg24explorerkit1
      file_id: spidrv_eusart_config
  - path: sl_iostream_eusart_xg24explorerkit1_config.h
    override:
      component: iostream_eusart
      instance: xg24explorerkit1
      file_id: iostream_eusart_config

define:
  - name: TF_LITE_STATIC_MEMORY
    value: "1"

configuration:
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_SPIDRV_EUSART_MIKROE_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: SL_SPIDRV_EUSART_XG24EXPLORERKIT1_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: SL_TFLITE_MICRO_ARENA_SIZE
    value: "8192"
  - name: SL_BT_CONFIG_CONNECTION_DATA_LENGTH
    value: "27"
  - name: SL_BLUETOOTH_COMMON_BUFFER_MEMORY_SIZE
    value: "8192"
  - name: SL_BT_CONTROLLER_BUFFER_MEMORY
    value: "8192"

tag:
  - hardware:rf:band:2400
